// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// ******** ENUMS ********
// Roles according requirement #3
enum UserRole {
  manager
  client
  delivery
}

enum TokenType {
  refresh
  password_reset
}

enum PaymentMethodType {
  payment_link
  payment_intent
}

enum OrderState {
  pending
  paid
  processing
  cancelled
  shipped
  delivered
}

enum PaymentStatus {
  processing
  succeeded
  failed
  refunded  // Not implemented
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ******** MODELS ********

model User {
  id           String    @id @default(uuid()) @db.Uuid
  stripeCustomerId  String? @unique @map("stripe_customer_id")
  username     String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(client)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  jwtTokens         JwtToken[]
  likes             Like[]
  cartItems         CartItem[]
  orders            Order[]           @relation("CustomerOrders")
  deliveries        Order[]           @relation("DeliveryOrders")
  shippingAddresses ShippingAddress[]

  @@map("users")
}

model JwtToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenId   String    @unique @map("token_id") // JTI
  isValid   Boolean   @default(true) @map("is_valid")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jwt_tokens")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @db.VarChar
  products Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar
  description String?          @db.Text
  basePrice   Int              @map("base_price")
  isActive    Boolean          @default(true) @map("is_active")
  categoryId  String           @db.Uuid @map("category_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  images      Image[]
  promoCodeApplications PromoCodeApplication[]

  @@map("products")
}

model ProductVariant {
  id                 String   @id @default(uuid()) @db.Uuid
  stripeProductId      String?  @unique @map("stripe_product_id")
  productId            String   @db.Uuid @map("product_id")
  stripePriceId        String?  @unique @map("stripe_price_id")
  stripePaymentLinkId  String?  @unique @map("stripe_payment_link_id")
  stripePaymentLinkUrl String?  @map("stripe_payment_link_url")
  sku                String   @unique @db.VarChar
  stock              Int
  priceCents         Int      @map("price_cents")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product            Product  @relation(fields: [productId], references: [id])
  images             Image[]
  
  variantAttributes VariantAttributeCategory[]
  likes       Like[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  promoCodeApplications PromoCodeApplication[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model AttributeCategory {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar
  attributes Attribute[]

  @@map("attribute_categories")
}

model Attribute {
  id                  String            @id @default(uuid()) @db.Uuid
  attributeCategoryId String            @map("attribute_category_id") @db.Uuid
  code                String            @db.VarChar @unique
  displayName         String            
  attributeCategory   AttributeCategory @relation(fields: [attributeCategoryId], references: [id])
  
  // Link to the junction table
  variantAttributes   VariantAttributeCategory[]
  @@index([attributeCategoryId])
  @@map("attributes")
}

model VariantAttributeCategory {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  attributeId String         @map("attribute_id") @db.Uuid

  variant     ProductVariant @relation(fields: [variantId], references: [id])
  attribute   Attribute      @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@index([attributeId])
  @@map("variant_attribute_categories")
}

model Image {
  id        String   @id @default(uuid()) @db.Uuid 
  productId String?  @db.Uuid @map("product_id")
  variantId String?  @db.Uuid @map("variant_id")
  imageUrl  String   @db.VarChar @map("image_url")
  imageKey  String   @db.VarChar @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product? @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("images")
}

model Like {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @db.Uuid @map("user_id")
  productVariantId  String      @db.Uuid @map("product_variant_id")
  createdAt         DateTime    @default(now()) @map("created_at")

  user              User       @relation(fields: [userId], references: [id])
  productVariant    ProductVariant    @relation(fields: [productVariantId], references: [id])

  @@map("likes")
  @@unique([userId, productVariantId]) 
}

model CartItem {
  id                String      @id @default(uuid()) @db.Uuid
  quantity          Int         @default(1)
  userId            String      @db.Uuid @map("user_id")
  productVariantId  String      @db.Uuid @map("product_variant_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user              User        @relation(fields: [userId], references: [id])
  productVariant    ProductVariant   @relation(fields: [productVariantId], references: [id])

  @@unique([userId, productVariantId])
  @@map("cart_items")
}

model Order {
  id                         String             @id @default(uuid()) @db.Uuid
  
  // User/Guest Identity
  userId                     String?            @db.Uuid @map("user_id")
  guestEmail                String?             @map("guest_email")
  
  // Logistics
  assignedDeliveryId       String?             @db.Uuid @map("assigned_delivery_id")
  shippingAddressId        String?             @db.Uuid @map("shipping_address_id")
  
  // Stripe Tracking
  stripePaymentIntentId   String?           @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?           @unique @map("stripe_checkout_session_id")
  paymentMethodType       PaymentMethodType @map("payment_method_type")

  // Financials
  totalAmountCents    Int @map("total_amount_cents")
  discountAmountCents Int @map("discount_amount_cents") @default(0)
  currentStatus           OrderState   @default(pending) @map("current_status")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations - Internal to this cluster
  shippingAddress            ShippingAddress?   @relation(fields: [shippingAddressId], references: [id])
  items                      OrderItem[]
  payments                   Payment[]
  statuses                   OrderStatus[]      // The event-sourcing timeline

  // Relations - External (Requires the User model)
  user                       User?              @relation("CustomerOrders", fields: [userId], references: [id])
  deliveryPerson            User?              @relation("DeliveryOrders", fields: [assignedDeliveryId], references: [id])

  @@map("orders")
}

model OrderStatus {
  id        String     @id @default(uuid()) @db.Uuid
  orderId   String     @db.Uuid @map("order_id")
  status    OrderState
  createdAt DateTime   @default(now()) @map("created_at")

  // Relations
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_statuses")
}

model OrderItem {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @db.Uuid @map("order_id")
  variantId            String   @db.Uuid @map("variant_id")
  quantity             Int
  priceAtPurchaseCents Int      @map("price_at_purchase_cents")
  discountAmountCents  Int?     @map("discount_amount_cents")

  // Relations
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant              ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id                        String        @id @default(uuid()) @db.Uuid
  stripePaymentAttemptId    String?       @map("stripe_payment_attempt_id")
  orderId                   String        @db.Uuid @map("order_id")
  amountCents               Int           @map("amount_cents")
  status                    PaymentStatus
  currency                  String        @db.VarChar(3)
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  // Relations
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ShippingAddress {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String?  @db.Uuid @map("user_id")
  recipientName         String   @map("recipient_name")
  phoneNumber           String   @map("phone_number")
  label                 String?  // e.g., 'Home', 'Office'
  street                String
  city                  String
  state                 String
  country               String
  additionalDescription String?  @map("additional_description")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders                Order[]

  @@map("shipping_addresses")
}

model PromoCode {
  id                     String       @id @default(uuid()) @db.Uuid
  campaignId             String?      @map("campaign_id") @db.Uuid
  code                   String       @unique
  discountType           DiscountType @map("discount_type")
  minPurchaseAmountCents Int?         @map("min_purchase_amount_cents")
  discountValue          Int          @map("discount_value")
  expirationDate         DateTime     @map("expiration_date")
  usageLimit             Int?         @map("usage_limit")
  usedCount              Int          @default(0) @map("used_count")
  isActive               Boolean      @default(true) @map("is_active")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  // --- Relations ---
  campaign     Campaign?              @relation(fields: [campaignId], references: [id])
  applications PromoCodeApplication[]

  @@map("promo_codes")
}

model PromoCodeApplication {
  id               String  @id @default(uuid()) @db.Uuid
  promoCodeId      String  @map("promo_code_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  productVariantId String? @map("product_variant_id") @db.Uuid

  // --- Relations ---
  promoCode      PromoCode       @relation(fields: [promoCodeId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([promoCodeId, productId])
  @@map("promo_code_applications")
}

model Campaign {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  // Made optional, as descriptions usually are
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // --- Relations ---
  // This completes the one-to-many link from the PromoCode model
  promoCodes  PromoCode[]

  @@map("campaigns")
}