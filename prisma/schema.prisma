// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// ******** ENUMS ********
// Roles according requirement #3
enum UserRole {
  manager
  client
  delivery
}

enum TokenType {
  refresh
  password_reset
}

// ******** MODELS ********

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String
  phoneNumber  String    @map("phone_number")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(client)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  jwtTokens    JwtToken[]
  likes        Like[]
  cartItems       CartItem[]

  // ADDING MORE WHEN BUILDING THOSE FEATURES

  @@map("users")
}

model JwtToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenId   String    @unique @map("token_id") // JTI
  isValid   Boolean   @default(true) @map("is_valid")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jwt_tokens")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @db.VarChar
  products Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar
  description String?          @db.Text
  basePrice   Int              @map("base_price")
  isActive    Boolean          @default(true) @map("is_active")
  categoryId  String           @db.Uuid @map("category_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  images      Image[]

  @@map("products")
}

model ProductVariant {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @db.Uuid @map("product_id")
  sku                String   @unique @db.VarChar
  stock              Int
  priceCents         Int      @map("price_cents")
  isActive           Boolean  @default(true) @map("is_active")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product            Product  @relation(fields: [productId], references: [id])
  images             Image[]
  
  variantAttributes VariantAttributeCategory[]
  likes       Like[]
  cartItems       CartItem[]
  // Future relations (cart and orders)
  // orderItems      OrderItem[]
  @@index([productId, isActive])
  @@map("product_variants")
}

model AttributeCategory {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar
  attributes Attribute[]

  @@map("attribute_categories")
}

model Attribute {
  id                  String            @id @default(uuid()) @db.Uuid
  // Renamed for clarity: it is an ID pointing to a Category
  attributeCategoryId String            @map("attribute_category_id") @db.Uuid
  code                String            @db.VarChar @unique
  displayName         String            
  attributeCategory   AttributeCategory @relation(fields: [attributeCategoryId], references: [id])
  
  // Link to the junction table
  variantAttributes   VariantAttributeCategory[]
  @@index([attributeCategoryId])
  @@map("attributes")
}

model VariantAttributeCategory {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  attributeId String         @map("attribute_id") @db.Uuid

  variant     ProductVariant @relation(fields: [variantId], references: [id])
  attribute   Attribute      @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@index([attributeId])
  @@map("variant_attribute_categories")
}

model Image {
  id        String   @id @default(uuid()) @db.Uuid 
  productId String?  @db.Uuid @map("product_id")
  variantId String?  @db.Uuid @map("variant_id")
  imageUrl  String   @db.VarChar @map("image_url")
  imageKey  String   @db.VarChar @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product? @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("images")
}

model Like {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @db.Uuid @map("user_id")
  productVariantId  String      @db.Uuid @map("product_variant_id")
  createdAt         DateTime    @default(now()) @map("created_at")

  user              User       @relation(fields: [userId], references: [id])
  productVariant    ProductVariant    @relation(fields: [productVariantId], references: [id])

  @@map("likes")
  @@unique([userId, productVariantId]) 
}

model CartItem {
  id                String      @id @default(uuid()) @db.Uuid
  quantity          Int         @default(1)
  userId            String      @db.Uuid @map("user_id")
  productVariantId  String      @db.Uuid @map("product_variant_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user              User        @relation(fields: [userId], references: [id])
  productVariant    ProductVariant   @relation(fields: [productVariantId], references: [id])

  @@unique([userId, productVariantId])
  @@map("cart_items")
}